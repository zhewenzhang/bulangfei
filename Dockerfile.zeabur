FROM node:18-alpine

WORKDIR /app

# 安裝 serve
RUN npm install -g serve

# 複製 package 文件
COPY package*.json ./

# 安裝依賴
RUN npm ci --only=production --silent

# 複製源代碼
COPY . .

# 構建應用
RUN npm run build

# 清理不需要的文件
RUN rm -rf src public node_modules

# 暴露端口
EXPOSE $PORT

# 啟動命令
CMD serve -s build -l $PORT