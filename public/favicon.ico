<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <!-- Piggy bank body -->
  <ellipse cx="50" cy="55" rx="35" ry="25" fill="#FFB6C1" stroke="#FF69B4" stroke-width="2"/>
  
  <!-- Piggy bank head -->
  <circle cx="25" cy="45" r="18" fill="#FFB6C1" stroke="#FF69B4" stroke-width="2"/>
  
  <!-- Snout -->
  <ellipse cx="15" cy="45" rx="8" ry="6" fill="#FF69B4"/>
  
  <!-- Nostrils -->
  <circle cx="12" cy="43" r="1.5" fill="#FF1493"/>
  <circle cx="12" cy="47" r="1.5" fill="#FF1493"/>
  
  <!-- Eyes -->
  <circle cx="22" cy="38" r="3" fill="#000"/>
  <circle cx="30" cy="38" r="3" fill="#000"/>
  <circle cx="23" cy="37" r="1" fill="#FFF"/>
  <circle cx="31" cy="37" r="1" fill="#FFF"/>
  
  <!-- Ears -->
  <ellipse cx="20" cy="28" rx="4" ry="6" fill="#FFB6C1" stroke="#FF69B4" stroke-width="1" transform="rotate(-20 20 28)"/>
  <ellipse cx="32" cy="28" rx="4" ry="6" fill="#FFB6C1" stroke="#FF69B4" stroke-width="1" transform="rotate(20 32 28)"/>
  
  <!-- Legs -->
  <rect x="20" y="75" width="6" height="12" fill="#FF69B4" rx="3"/>
  <rect x="35" y="75" width="6" height="12" fill="#FF69B4" rx="3"/>
  <rect x="55" y="75" width="6" height="12" fill="#FF69B4" rx="3"/>
  <rect x="70" y="75" width="6" height="12" fill="#FF69B4" rx="3"/>
  
  <!-- Tail -->
  <path d="M 80 50 Q 90 45 85 55 Q 88 60 82 58" fill="none" stroke="#FF69B4" stroke-width="3" stroke-linecap="round"/>
  
  <!-- Coin slot -->
  <rect x="45" y="35" width="12" height="3" fill="#FF1493" rx="1.5"/>
  
  <!-- Coin -->
  <circle cx="51" cy="25" r="4" fill="#FFD700" stroke="#FFA500" stroke-width="1"/>
  <text x="51" y="28" text-anchor="middle" font-family="Arial" font-size="6" fill="#FF8C00">$</text>
</svg>